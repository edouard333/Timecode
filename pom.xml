<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <groupId>com.phenix</groupId>
    <artifactId>timecode</artifactId>
    <version>0.8.4</version>
    <packaging>jar</packaging>
    
    <name>Timecode</name>
    <description>Librairie gérant le timecode.</description>
    <url>https://github.com/edouard333/Timecode</url>
    
    <developers>
        <developer>
            <name>Edouard Jeanjean</name>
            <email>edouard128@hotmail.com</email>
            <url>https://github.com/edouard333</url>
        </developer>
    </developers>
    
    <build>
        <plugins>
            <!-- Fait des vérifications sur le projet. -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-enforcer-plugin</artifactId>
                <version>3.6.2</version>
                <executions>
                    <execution>
                        <id>enforce-files-exist</id>
                        <goals>
                            <goal>enforce</goal>
                        </goals>
                        <configuration>
                            <rules>
                                <!-- Vérifie qu'on utilise la bonne version de JDK. -->
                                <requireJavaVersion>
                                    <version>25</version>
                                </requireJavaVersion>
                                <!-- Vérifie qu'est indiqué le mode d'encodage des sources. -->
                                <requireProperty>
                                    <property>project.build.sourceEncoding</property>
                                    <regex>^(UTF-8)$</regex>
                                    <message>Le sourceEncoding doit être renseigné.</message>
                                    <regexMessage>Le sourceEncoding doit être "UTF-8".</regexMessage>
                                </requireProperty>
                                <!-- Vérifie qu'est indiqué la version du JDK pour la compilation. -->
                                <requireProperty>
                                    <property>maven.compiler.release</property>
                                    <regex>^(25)$</regex>
                                    <message>La version du JDK (compiler.release) doit être 25.</message>
                                </requireProperty>
                                <!-- Vérifie que les propriétés existent et ont des valeurs valides. -->
                                <requireProperty>
                                    <property>appType</property>
                                    <message>"appType" doit être défini.</message>
                                    <regex>^(graphic|console|library)$</regex>
                                    <regexMessage>La valeur doit être soit "graphic" soit "console" soit "library".</regexMessage>
                                </requireProperty>
                                <!-- Vérifie que la propriété "skipTests" existe. -->
                                <requireProperty>
                                    <property>skipTests</property>
                                    <message>"skipTests" doit être défini.</message>
                                    <regex>^(false|true)$</regex>
                                    <regexMessage>"skipTests" doit être soit "true" soit "false".</regexMessage>
                                </requireProperty>
                            </rules>
                            <fail>true</fail>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            
            <!-- Ajoute le code source dans Maven. -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-source-plugin</artifactId>
                <version>3.4.0</version>
                <executions>
                    <execution>
                        <id>attach-sources</id>
                        <phase>verify</phase>
                        <goals>
                            <goal>jar-no-fork</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        
            <!-- Ajoute la JavaDoc dans Maven. -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-javadoc-plugin</artifactId>
                <version>3.12.0</version>
                <executions>
                    <execution>
                        <id>attach-javadoc</id>
                        <goals>
                            <goal>jar</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
            
            <!-- Génère des checksums. -->
            <plugin>
                <groupId>net.nicoulaj.maven.plugins</groupId>
                <artifactId>checksum-maven-plugin</artifactId>
                <version>1.11</version>
                <executions>
                    <execution>
                        <phase>verify</phase>
                        <goals>
                            <goal>files</goal>
                        </goals>
                        <configuration>
                            <fileSets>
                                <!-- Inclure les fichiers de build Maven. -->
                                <fileSet>
                                    <directory>${project.build.directory}</directory>
                                    <includes>
                                        <include>*-${project.version}.jar</include>
                                        <include>*-${project.version}-sources.jar</include>
                                        <include>*-${project.version}-javadoc.jar</include>
                                    </includes>
                                </fileSet>
                            </fileSets>
                            <csvSummaryFile>checksums-${project.version}.csv</csvSummaryFile>
                            <!-- L'algorithme de hash. -->
                            <algorithms>
                                <algorithm>SHA-1</algorithm>
                                <algorithm>MD5</algorithm>
                            </algorithms>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            
            <!-- Pour le coverage mode. -->
            <plugin>
                <groupId>org.jacoco</groupId>
                <artifactId>jacoco-maven-plugin</artifactId>
                <version>0.8.14</version>
                <configuration>
                    <skip>${skipTests}</skip>
                </configuration>
                <executions>
                    <execution>
                        <goals>
                            <goal>prepare-agent</goal>
                        </goals>
                    </execution>
                    <execution>
                        <id>report</id>
                        <phase>prepare-package</phase>
                        <goals>
                            <goal>report</goal>
                        </goals>
                    </execution>
                    <!-- Vérification du seuil de couverture. -->
                    <execution>
                        <id>check</id>
                        <phase>verify</phase>
                        <goals>
                            <goal>check</goal>
                        </goals>
                        <configuration>
                            <rules>
                                <rule>
                                    <element>BUNDLE</element> <!-- Vérifie la couverture globale. -->
                                    <limits>
                                        <limit>
                                            <counter>LINE</counter>  <!-- Vérifie le % de lignes couvertes. -->
                                            <value>COVEREDRATIO</value>
                                            <minimum>0.01</minimum> <!-- Fixe le seuil à 1%. -->
                                        </limit>
                                    </limits>
                                </rule>
                            </rules>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            
            <!-- Pour permettre d'utiliser vraiment JUnit... en tout cas l'annotation "@BeforeEach". -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>3.5.4</version>
                <configuration>
                    <skipTests>${skipTests}</skipTests>
                </configuration>
            </plugin>
        </plugins>
    </build>
    
    <dependencies>
        <!-- Ajout des annotations @NotNull, etc. -->
        <dependency>
            <groupId>jakarta.validation</groupId>
            <artifactId>jakarta.validation-api</artifactId>
            <version>3.1.1</version>
        </dependency>
        <!-- Avoir les options d'annotation JUnit. -->
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter-api</artifactId>
            <version>6.0.1</version>
            <scope>test</scope>
        </dependency>
    </dependencies>
    
    <properties>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <maven.compiler.release>25</maven.compiler.release>
        <!-- Type d'application : "graphic", "console" ou "library". -->
        <appType>library</appType>
        <!-- Indique si on saute ou non les tests (et du coup le coverage mode). -->
        <skipTests>false</skipTests>
    </properties>
</project>